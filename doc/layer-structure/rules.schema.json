{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Draft Photoshop layer rule registry",
  "type":"object",
  "additionalProperties":false,
  "required":["$schema","schemaVersion","status","enforcement","description","normalization","rules","components"],
  "properties":{
    "$schema":{"type":"string"},
    "schemaVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status":{"const":"draft"},
    "enforcement":{"const":"advisory"},
    "description":{"type":"string","minLength":1},
    "normalization":{
      "type":"object","additionalProperties":false,
      "required":["preserveRawName","excludedAncestorPrefix","observedExportSuffixRemoved","pluginExcludedSuffix","casePolicy","identityScope"],
      "properties":{
        "preserveRawName":{"const":true},"excludedAncestorPrefix":{"type":"string"},
        "observedExportSuffixRemoved":{"type":"string"},"pluginExcludedSuffix":{"type":"string"},
        "casePolicy":{"type":"string"},"identityScope":{"type":"string"}
      }
    },
    "rules":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/rule"}},
    "components":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/component"}}
  },
  "$defs":{
    "basis":{"enum":["template-observed","sample-observed","export-confirmed","plugin-observed","proposed","production-confirmed-historical"]},
    "strings":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "rule":{
      "type":"object","additionalProperties":false,
      "required":["id","title","severity","basis","stage","check","exclusions","repair"],
      "properties":{
        "id":{"type":"string","pattern":"^LS-[0-9]{3}$"},
        "title":{"type":"string","minLength":1},
        "severity":{"enum":["error","warning","info","review"]},
        "basis":{"$ref":"#/$defs/basis"},
        "stage":{"enum":["source","export","runtime"]},
        "check":{"type":"string","minLength":1},"exclusions":{"type":"string","minLength":1},"repair":{"type":"string","minLength":1}
      }
    },
    "component":{
      "type":"object","additionalProperties":false,
      "required":["id","canonicalNamePattern","kind","mode","basis","statePaths","recommendedChildPaths","observedControlPaths","evidence","rules","exceptions","runtimeStatus"],
      "properties":{
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9]*$"},
        "canonicalNamePattern":{"type":"string","minLength":1},
        "kind":{"const":"group"},
        "mode":{"enum":["slides","triggered-slides","categorized","sequence","comparison","data-template","data-map","targets","container","scenes"]},
        "basis":{"$ref":"#/$defs/basis"},
        "statePaths":{"$ref":"#/$defs/strings"},
        "recommendedChildPaths":{"$ref":"#/$defs/strings"},
        "observedControlPaths":{"$ref":"#/$defs/strings"},
        "evidence":{
          "type":"object","additionalProperties":false,"required":["source","path"],
          "properties":{"source":{"type":"string","minLength":1},"path":{"type":"array","items":{"type":"string","minLength":1}}}
        },
        "rules":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^LS-[0-9]{3}$"}},
        "exceptions":{"$ref":"#/$defs/strings"},
        "runtimeStatus":{"type":"string","minLength":1}
      }
    }
  }
}
