# Box Client Credentials Grant configuration for direct feedback submission.
# Keep real values in .env.local; never commit them.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_FEEDBACK_FOLDER_ID=

# Private Notion credentials for optional creative-team usability tracking.
# Keep real values in .env.local; never commit them or place them in browser code.
NOTION_API_TOKEN=
NOTION_PILOT_DATABASE_ID=
TURBO_APP_ORIGIN=

# Public Mapbox token for local preview only; restrict its URLs to localhost.
VITE_MAPBOX_ACCESS_TOKEN=

